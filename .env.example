TELEGRAM_BOT_TOKEN=your_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=google-gla:gemini-flash-lite-latest
# SUMMARIZER_MODEL=google-gla:gemini-2.0-flash  # defaults to AI_MODEL
# CHAT_MODEL=                                    # defaults to AI_MODEL
# CORRECTOR_MODEL=                               # defaults to AI_MODEL
# PROMPT_ENGINEER_MODEL=                         # defaults to AI_MODEL
WHISPER_MODEL=base  # options: tiny, base, small, medium, large-v3
POLL_INTERVAL_SECONDS=3600
TRANSCRIBER=whisper  # options: whisper, groq, nemotron
GROQ_API_KEY=  # Required when TRANSCRIBER=groq
# Nemotron-3.5 streaming ASR (local, CPU, multilingual). Point at a sherpa-onnx model dir
# (encoder/decoder/joiner .onnx + tokens.txt), e.g. csukuangfj2/sherpa-onnx-nemotron-3.5-asr-streaming-0.6b-1120ms-int8-2026-06-11
NEMOTRON_MODEL_DIR=  # Required when TRANSCRIBER=nemotron
NEMOTRON_LANGUAGE=auto  # en, zh, ja, ... or auto (per-stream language hint)
WEB_USER_TELEGRAM_ID=123456789  # your Telegram user ID; used until Telegram Login Widget auth is implemented
DATABASE_URL=postgresql://podcast:secret@db:5432/podcast_bot

# Optional: Google Drive integration (OAuth 2.0)
# GOOGLE_DRIVE_UPLOAD=true  # set to false to disable Drive uploads entirely (default: true)
# GOOGLE_DRIVE_TOKEN_PATH=/path/to/token.json  # run: uv run python -m scripts.drive_auth to generate
# GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWx  # folder ID from Drive URL
